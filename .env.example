# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Qdrant Configuration
QDRANT_URL=your_qdrant_url
QDRANT_API_KEY=your_qdrant_api_key

# LiteLLM Configuration
PRIMARY_MODEL_NAME=gemini/gemini-3.6-flash
SECONDARY_MODEL_NAME=gemini/gemini-3.5-flash-lite
TERTIARY_MODEL_NAME=gemini/gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key
EMBEDDING_MODEL=your_embedding_model

# App Configuration
LOG_LEVEL=INFO
KT_CONFIDENCE_THRESHOLD=your_value

# Embedding & RAG Configuration
EMBEDDING_DIM=your_embedding_dim
CHUNK_SIZE=your_chunk_size
CHUNK_OVERLAP=your_chunk_overlap
RAG_CONTEXT_SIZE=your_context_size
QDRANT_COLLECTION=your_collection_name

# GitHub Integration (Phase 1: public repos work without a token)
# Uncomment and set below for private repo support (Phase 2)
# GITHUB_PAT=ghp_your_personal_access_token